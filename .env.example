# Copy this file to .env and replace the placeholders. Never commit .env.
JWT_SECRET_KEY=replace-with-a-long-random-secret
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
COURSEPILOT_API_URL=http://127.0.0.1:8000

# Optional short-term conversation cache; SQLite remains the business store.
REDIS_URL=redis://127.0.0.1:6379/0

# Course material embeddings: primary hosted model, backup local Ollama.
DASHSCOPE_API_KEY=replace-with-your-dashscope-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PRIMARY_EMBEDDING_MODEL=text-embedding-v4
BACKUP_EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024
OLLAMA_EMBED_URL=http://127.0.0.1:11434/api/embed
